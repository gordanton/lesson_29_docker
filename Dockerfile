# Официальный образ Python. Суффикс slim — урезанная версия Debian:
# в ней есть интерпретатор, но нет лишних утилит, поэтому образ меньше.
FROM python:3.12-slim

# Рабочая папка внутри контейнера. Дальнейшие команды выполняются из неё.
WORKDIR /app

# Сначала зависимости, потом код. Пока requirements.txt не меняется,
# Docker берёт уже установленный Flask из кэша и не качает его заново.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py .

ENV PORT=5000

# Подсказка, какой порт слушает приложение.
# Сам по себе EXPOSE порт наружу не открывает — это делает флаг -p при запуске.
EXPOSE 5000

# Запуск без оболочки shell: процесс Python станет главным процессом контейнера (PID 1).
CMD ["python", "app.py"]
